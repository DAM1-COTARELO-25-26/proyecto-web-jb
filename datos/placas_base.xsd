<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="infraestructura_placa">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="inventario">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="fabricante" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="placa" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="modelo" type="xs:string"/>
                          <xs:element name="especificaciones">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="socket" type="xs:string"/>
                                <xs:element name="chipset" type="xs:string"/>
                                <xs:element name="formato" type="xs:string"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="precio">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:decimal">
                                  <xs:attribute name="moneda" type="xs:string" fixed="EUR"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="estado">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:integer">
                                  <xs:attribute name="disponible" type="xs:boolean" use="required"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="fechaRegistro" type="xs:date"/>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:ID" use="required"/>
                        <xs:attribute name="gama" type="xs:string"/>
                        <xs:attribute name="wifi" type="xs:boolean"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="nombre" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="categoria" type="xs:string" fixed="Placas Base"/>
            <xs:attribute name="fechaActualizacion" type="xs:date" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="tienda" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>