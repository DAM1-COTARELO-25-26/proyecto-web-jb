<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="unidad_central_proceso">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fabricante" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="chip" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="modelo" type="xs:string"/>
                    <xs:element name="rendimiento">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="nucleos_hilos" type="xs:string"/>
                          <xs:element name="socket" type="xs:string"/>
                          <xs:element name="frecuencia">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:decimal">
                                  <xs:attribute name="unidad" type="xs:string" use="required" fixed="GHz"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="precio">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:decimal">
                            <xs:attribute name="moneda" type="xs:string" use="required" fixed="EUR"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="estado">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:integer">
                            <xs:attribute name="disponible" type="xs:boolean" use="required"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="fechaRegistro" type="xs:date"/>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:ID" use="required"/>
                  <xs:attribute name="serie" type="xs:string" use="required"/>
                  <xs:attribute name="destacado" type="xs:boolean" default="false"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="nombre" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="Intel"/>
                  <xs:enumeration value="AMD"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="arquitectura" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="tienda" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>